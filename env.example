DATABASE_URL=postgres://user:password@example.com:5432/dbname

# NextAuth.js Configuration
NEXTAUTH_SECRET=your-secret-here
AUTH_TRUST_HOST=true

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Authorized Emails (comma-separated)
AUTHORIZED_EMAILS=user@example.com

# Cron Job Authentication (optional, for additional security)
# If set, cron jobs must include: Authorization: Bearer <CRON_SECRET>
# If not set, Vercel's automatic x-vercel-cron header is used
CRON_SECRET=your-cron-secret-here